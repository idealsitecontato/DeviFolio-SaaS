{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["*.js", "src/**/*.js", "server/**/*.js", "api/**/*.js", "tests/**/*.js"],
  "exclude": ["node_modules", "dist", "guio-service"]
}
